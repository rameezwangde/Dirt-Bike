# ----------------------------------------------------------------------
# 1. Directory Index
# ----------------------------------------------------------------------
DirectoryIndex index.html index.php

# ----------------------------------------------------------------------
# 2. Disable Cache on HTML to prevent stale SPA bundles
# ----------------------------------------------------------------------
<FilesMatch "\.(html|htm)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 3. SPA Routing Fallback (Prevents 404 on page refresh)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite if request is for existing file or folder or symbolic link
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback in case mod_rewrite is disabled/restricted on Apache
ErrorDocument 404 /index.html
